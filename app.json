{
  "expo": {
    "name": "My Car Maintenance",
    "slug": "my-car-maintenance",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "mycarmaintenance",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.fabiobenavides.mycarmaintenance",
      "infoPlist": {
        "NSUserNotificationsUsageDescription": "Usamos notificaciones para recordarte la próxima revisión de tu carro."
      }
    },
    "android": {
      "package": "com.fabiobenavides.mycarmaintenance",
      "adaptiveIcon": {
        "backgroundColor": "#0F6B7A",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "color": "#0F6B7A",
          "defaultChannel": "mantenimiento"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Usamos tus fotos para que puedas agregar imágenes opcionales de tu carro o de un servicio (factura, escaneo u otra prueba).",
          "cameraPermission": "Usamos la cámara para que puedas tomar fotos opcionales de tu carro o de un servicio (factura, escaneo u otra prueba).",
          "microphonePermission": false
        }
      ]
    ],
    "notification": {
      "color": "#0F6B7A"
    },
    "extra": {
      "eas": {
        "projectId": "2922ccf8-0b59-4ed0-950c-46587272fa59"
      }
    }
  }
}
